using Gtk 4.0;
using Adw 1;

template $ChameleonWindow: Adw.ApplicationWindow {
  title: _("Chameleon");
  default-width: 800;
  default-height: 600;

  Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;
        }
      }

      Adw.Bin main_box {
        hexpand: true;
        vexpand: true;

        styles [
          "drop-area",
        ]

        Box {
          orientation: vertical;
          spacing: 20;
          halign: center;
          valign: center;
          hexpand: true;
          vexpand: true;
          margin-top: 32;
          margin-bottom: 32;
          margin-start: 32;
          margin-end: 32;

          Image {
            icon-name: "folder-pictures-symbolic";
            pixel-size: 96;
            opacity: 0.45;
            margin-bottom: 8;
            accessible-role: presentation;
          }

          Label {
            label: _("Drop images here");

            styles [
              "title-1",
            ]

            justify: center;
            wrap: true;
          }

          Label {
            label: _("or use the buttons below to select files");

            styles [
              "dim-label",
            ]

            justify: center;
            wrap: true;
            margin-bottom: 8;
          }

          /* Action buttons row */
          Box {
            orientation: horizontal;
            spacing: 12;
            halign: center;
            margin-top: 8;

            /* Main image selection button */
            Button add_image_files_button {
              child: Box {
                orientation: horizontal;
                spacing: 8;

                Image {
                  icon-name: "document-open-symbolic";
                  pixel-size: 20;
                }

                Label {
                  label: _("Select Images");
                }
              };

              width-request: 180;

              styles [
                "suggested-action",
                "pill",
              ]
            }

            /* HEIC import button placed to the right */
            Button import_heic_button {
              child: Box {
                orientation: horizontal;
                spacing: 8;

                Image {
                  icon-name: "insert-image-symbolic";
                  pixel-size: 20;
                }

                Label {
                  label: _("Import HEIC");
                }
              };

              width-request: 180;

              styles [
                "pill",
              ]
            }
          }
        }
      }
    };
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Chameleon");
      action: "app.about";
    }
  }
}
